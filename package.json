{
  "name": "skill-hub-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node tools/hub/cli.mjs validate",
    "build": "node tools/hub/cli.mjs build",
    "build:check": "node tools/hub/cli.mjs build --check",
    "list": "node tools/hub/cli.mjs list",
    "test": "node --test tools/hub/lib.test.mjs skills/skill-qa/tests/qa.test.mjs",
    "qa": "node tools/hub/cli.mjs qa",
    "publish:local": "node tools/hub/publish-local.mjs"
  },
  "dependencies": {
    "yaml": "2.6.1"
  }
}
