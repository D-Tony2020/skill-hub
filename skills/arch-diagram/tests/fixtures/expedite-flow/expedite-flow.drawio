<mxfile host="arch-diagram">
  <diagram id="page-1" name="总览">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="缺料催料流程（跨角色）" style="text;html=1;fontSize=16;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="560" height="30" as="geometry" />
        </mxCell>
      
        <mxCell id="planner" value="计划员" style="swimlane;horizontal=0;startSize=32;collapsible=0;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#90a4ae;fontStyle=1;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1440" height="140" as="geometry" /></mxCell>
        <mxCell id="system" value="系统" style="swimlane;horizontal=0;startSize=32;collapsible=0;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#90a4ae;fontStyle=1;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="1440" height="140" as="geometry" /></mxCell>
        <mxCell id="buyer" value="采购员" style="swimlane;horizontal=0;startSize=32;collapsible=0;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#90a4ae;fontStyle=1;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="1440" height="140" as="geometry" /></mxCell>
        <mxCell id="supplier" value="供应商" style="swimlane;horizontal=0;startSize=32;collapsible=0;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#90a4ae;fontStyle=1;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1440" height="140" as="geometry" /></mxCell>
        <mxCell id="found" value="发现缺料" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#455a64;fontFamily=Arial;fontSize=12;" vertex="1" parent="planner"><mxGeometry x="60" y="45" width="140" height="50" as="geometry" /></mxCell>
        <mxCell id="track" value="跟踪到货" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#455a64;fontFamily=Arial;fontSize=12;" vertex="1" parent="planner"><mxGeometry x="250" y="45" width="140" height="50" as="geometry" /></mxCell>
        <mxCell id="update" value="更新排产" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#455a64;fontFamily=Arial;fontSize=12;" vertex="1" parent="planner"><mxGeometry x="1050" y="45" width="140" height="50" as="geometry" /></mxCell>
        <mxCell id="end" value="结束" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontFamily=Arial;fontSize=12;" vertex="1" parent="planner"><mxGeometry x="1260" y="50" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="has_transit" value="是否有在途？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57c00;fontFamily=Arial;fontSize=12;" vertex="1" parent="system"><mxGeometry x="250" y="30" width="140" height="80" as="geometry" /></mxCell>
        <mxCell id="send" value="发送催料单" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#455a64;fontFamily=Arial;fontSize=12;" vertex="1" parent="system"><mxGeometry x="450" y="45" width="140" height="50" as="geometry" /></mxCell>
        <mxCell id="urgent" value="是否紧急？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57c00;fontFamily=Arial;fontSize=12;" vertex="1" parent="buyer"><mxGeometry x="450" y="30" width="140" height="80" as="geometry" /></mxCell>
        <mxCell id="call" value="电话催料" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#455a64;fontFamily=Arial;fontSize=12;" vertex="1" parent="buyer"><mxGeometry x="650" y="45" width="140" height="50" as="geometry" /></mxCell>
        <mxCell id="reply" value="回复交期" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#455a64;fontFamily=Arial;fontSize=12;" vertex="1" parent="supplier"><mxGeometry x="850" y="45" width="140" height="50" as="geometry" /></mxCell>
        <mxCell id="e1" value="提交缺料" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#37474f;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="found" target="has_transit"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#37474f;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="has_transit" target="track"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#37474f;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="has_transit" target="urgent"><mxGeometry relative="1" as="geometry" /></mxCell>
