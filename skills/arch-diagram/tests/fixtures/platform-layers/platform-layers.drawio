<diagram id="page-2" name="齐套 Agent 内部"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title-2" value="齐套 Agent · 内部结构" style="text;html=1;fontSize=16;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="400" height="30" as="geometry" /></mxCell><mxCell id="k-planner" value="&lt;b&gt;规划器&lt;/b&gt;&lt;br&gt;拆解齐套任务" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00796b;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="180" height="60" as="geometry" /></mxCell><mxCell id="k-tools" value="&lt;b&gt;工具调用&lt;/b&gt;&lt;br&gt;ERP / WMS / SRM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00796b;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="180" height="60" as="geometry" /></mxCell><mxCell id="k-verify" value="&lt;b&gt;结果校验&lt;/b&gt;&lt;br&gt;齐套率复核" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00796b;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="120" width="180" height="60" as="geometry" /></mxCell><mxCell id="k-mem" value="&lt;b&gt;记忆读写&lt;/b&gt;&lt;br&gt;催料历史" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="280" width="120" height="80" as="geometry" /></mxCell><mxCell id="ke1" value="执行计划" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#37474f;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k-planner" target="k-tools"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ke2" value="工具结果" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#37474f;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k-tools" target="k-verify"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ke3" value="不通过·重规划" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k-verify" target="k-planner"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="80" /><mxPoint x="170" y="80" /></Array></mxGeometry></mxCell><mxCell id="ke4" value="读写" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;startArrow=classic;startFill=1;strokeColor=#2e7d32;fontColor=#2e7d32;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="k-planner" target="k-mem"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
