#!/usr/bin/env bash
# Launcher: finds a Python 3 on Linux/macOS/Windows Git Bash and runs sd.py.
# Usage: bash "$SKILL/scripts/sd" <command> [args]
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for py in python3 python "py -3"; do
  if $py -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
    PYTHONIOENCODING=utf-8 exec $py "$here/sd.py" "$@"
  fi
done
echo "RESULT fail code=E_NO_PYTHON need Python 3.8+ (Windows: winget install Python.Python.3.12, then reopen the terminal)"
exit 1
